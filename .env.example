# VPO Corp local web app
VPO_USER=admin
VPO_PASSWORD=change-me
VPO_HOST=127.0.0.1
VPO_PORT=8000

# Google Cloud Storage publication / local API cache
GCS_BUCKET=vpo-corp-royalties-marts
GCS_PREFIX=marts
GOOGLE_APPLICATION_CREDENTIALS=C:\royalties_pipeline\secrets\gcs_service_account.json

# VPO Corp production-style API
VPO_API_KEY=change-me
VPO_LOCAL_MARTS_DIR=C:\royalties_pipeline\warehouse\marts
VPO_API_CACHE_DIR=C:\royalties_pipeline\cache\gcs_marts
VPO_API_REPORTS_DIR=C:\royalties_pipeline\reports\api
GOOGLE_SHEETS_SHARE_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_TOKEN_JSON=

# Cloud Run can use its attached service account for GCS.
# In that case GOOGLE_APPLICATION_CREDENTIALS and GCS_SERVICE_ACCOUNT_JSON are not needed.
