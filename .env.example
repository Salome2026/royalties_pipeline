# VPO Corp local web app
VPO_USER=admin
VPO_PASSWORD=change-me
VPO_HOST=127.0.0.1
VPO_PORT=8000

# Google Cloud Storage publication / local API cache
GCS_BUCKET=vpo-corp-royalties-marts
GCS_PREFIX=marts
GOOGLE_APPLICATION_CREDENTIALS=C:\royalties_pipeline\.secrets\gcs_service_account.json

# VPO Corp production-style API
VPO_API_KEY=change-me
VPO_LOCAL_MARTS_DIR=C:\royalties_pipeline\warehouse\marts
VPO_API_CACHE_DIR=C:\royalties_pipeline\cache\gcs_marts
VPO_API_REPORTS_DIR=C:\royalties_pipeline\reports\api

# Operational database.
# Production/live operation uses Cloud SQL Postgres as the single source of truth.
# Local SQLite snapshots are historical backups only after the Cloud SQL cutover.
VPO_OPERATIONAL_DB_DRIVER=postgres
VPO_POSTGRES_CONNECT_MODE=local_proxy
VPO_OPERATIONAL_DB_NAME=vpo_corp
VPO_OPERATIONAL_DB_USER=postgres
VPO_OPERATIONAL_DB_PASSWORD=
VPO_CLOUDSQL_CONNECTION_NAME=vpo-corp-royalties:us-central1:vpo-corp-postgres
VPO_POSTGRES_LOCAL_PROXY_HOST=127.0.0.1
VPO_POSTGRES_LOCAL_PROXY_PORT=5432
VPO_ALLOW_DIRECT_POSTGRES_TCP=

VPO_CATALOG_STATUS_SYNC_GCS=1
VPO_CATALOG_STATUS_GCS_OBJECT=marts/catalog_status.parquet
GOOGLE_SHEETS_SHARE_EMAIL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_TOKEN_JSON=

# Catalog metadata lookups
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Cloud Run can use its attached service account for GCS.
# In that case GOOGLE_APPLICATION_CREDENTIALS and GCS_SERVICE_ACCOUNT_JSON are not needed.
